# =============================================================================
# Configuração do Google — copie este arquivo para `.env` (gitignored) e
# preencha os valores. NUNCA comite segredos reais.
# =============================================================================

# -----------------------------------------------------------------------------
# OBRIGATÓRIO — Client ID do OAuth 2.0 (Google Identity Services)
# -----------------------------------------------------------------------------
# 1. https://console.cloud.google.com/ → crie/selecione um projeto.
# 2. Ative a "Google Drive API".
# 3. Configure a "Tela de permissão OAuth" (tipo Externo) e adicione seu
#    usuário como "Usuário de teste".
# 4. "Credenciais" → "ID do cliente OAuth" → tipo "Aplicativo da Web".
# 5. Em "Origens JavaScript autorizadas", adicione a origem do app
#    (ex.: http://localhost:5173 em desenvolvimento).
VITE_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# OPCIONAL — Pasta exclusiva do cofre no Drive
# -----------------------------------------------------------------------------
# Nome da pasta raiz criada/aberta pelo app. Padrão: mydocs_vault
VITE_VAULT_FOLDER_NAME=mydocs_vault

# -----------------------------------------------------------------------------
# OPCIONAL — Limite de tamanho por arquivo (bytes). Padrão: 10 MB
# -----------------------------------------------------------------------------
VITE_MAX_FILE_BYTES=10485760
